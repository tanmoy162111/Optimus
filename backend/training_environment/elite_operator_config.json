        "advanced_operator": {
            "overall_score": 70,
            "skills_mastery": 65,
            "adversarial_success_rate": 60,
            "stealth_operations": 65
        }
    },
    
    "reward_structure": {
        "stealth_bonus": 1.5,
        "speed_bonus": 1.3,
        "completeness_bonus": 2.0,
        "zero_detection_bonus": 3.0,
        "challenge_completion": 100,
        "phase_completion": 200
