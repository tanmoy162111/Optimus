        }
    ],
    
    "total_hours": 24,
    
    "phases": {
        "red_team_operations": {
            "enabled": true,
            "hours": 4,
            "description": "Advanced offensive operations and infrastructure",
            "lessons": [
                "Advanced OSINT & Reconnaissance",
                "Active Directory Exploitation",
                "Network Pivoting & Tunneling",
                "C2 Infrastructure & Persistence"
            ],
            "skills": [
                "bloodhound", "mimikatz", "rubeus", "kerberoasting",
                "chisel", "ligolo", "ssh_tunneling", "covenant", "sliver"
            ],
            "expected_outcomes": {
                "domain_admin": true,
                "pivots_established": 3,
                "persistence_mechanisms": 5
            }
        },
        "exploit_development": {
            "enabled": true,
            "hours": 4,
            "description": "Binary exploitation and custom exploit creation",
            "lessons": [
                "Binary Exploitation Fundamentals",
                "Advanced Buffer Overflow & ROP",
                "Heap Exploitation",
                "Custom Exploit Development"
            ],
            "skills": [
                "gdb", "radare2", "ropper", "rop_chains",
                "heap_exploitation", "use_after_free", "shellcode_dev"
            ],
            "expected_outcomes": {
                "exploits_working": 5,
                "rop_chains_built": 3,
                "custom_exploits": 3
            }
        },
        "adversarial_scenarios": {
            "enabled": true,
            "hours": 4,
            "description": "Operating under defensive pressure",
            "lessons": [
                "Blue Team Evasion",
                "WAF & IDS Bypass Mastery",
                "Time-Limited Breach Scenarios",
                "Multi-Target Compromise"
            ],
            "skills": [
                "soc_evasion", "siem_bypass", "waf_bypass_advanced",
                "ids_evasion", "rapid_exploitation", "coordinated_attacks"
            ],
            "expected_outcomes": {
                "detection_rate": 0.15,
                "waf_bypass_success": 0.8,
                "time_limited_challenges": 3
            }
        },
        "zero_day_hunting": {
            "enabled": true,
            "hours": 4,
            "description": "Vulnerability research and discovery",
            "lessons": [
                "Fuzzing & Vulnerability Discovery",
                "Code Review for Vulnerabilities",
                "Logic Flaw Identification",
                "Novel Attack Vector Development"
            ],
            "skills": [
                "fuzzing", "afl", "radamsa", "boofuzz",
                "semgrep", "codeql", "static_analysis", "vulnerability_research"
            ],
            "expected_outcomes": {
                "vulnerabilities_discovered": 3,
                "exploitable_zero_day": 1,
                "poc_developed": 2
            }
        },
        "apt_simulation": {
            "enabled": true,
            "hours": 4,
            "description": "Advanced Persistent Threat operations",
            "lessons": [
                "Enterprise Network Compromise",
                "Long-Term Persistence",
                "Data Exfiltration Techniques",
                "Anti-Forensics & Cleanup"
            ],
            "skills": [
                "enterprise_compromise", "rootkit_deployment",
                "dns_tunneling", "covert_channels", "anti_forensics"
            ],
            "expected_outcomes": {
                "full_enterprise_compromise": true,
                "persistence_survival_rate": 0.9,
                "forensic_evasion": 0.85
            }
        },
        "certification": {
            "enabled": true,
            "hours": 4,
            "description": "Comprehensive assessment and certification",
            "lessons": [
                "Comprehensive Assessment",
                "Final APT Scenario"
            ],
            "skills": ["all_skills", "professional_reporting"],
            "expected_outcomes": {
                "overall_score": 0.85,
                "apt_scenario_complete": true,
                "report_quality": 0.9
            }
        }
