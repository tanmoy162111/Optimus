{
    "training_name": "Elite Operator Advanced Training",
    "version": "1.0",
    "description": "24-hour advanced curriculum for master penetration testers",
    
    "prerequisites": {
        "min_base_training_hours": 10,
        "min_skill_level": 60,
        "required_certifications": ["newbie_to_pro"]
    },
    
    "targets": [
        {
            "name": "OWASP_Juice_Shop",
            "url": "https://juice-shop.herokuapp.com",
            "type": "web_application",
            "difficulty": "advanced",
            "protections": ["waf_simulation"],
            "training_focus": ["web_attacks", "evasion", "chain_attacks"]
        },
        {
            "name": "VMware_Target",
            "url": "http://192.168.131.128",
            "type": "linux_server",
            "difficulty": "expert",
            "protections": [],
